{
  "name": "taskflow-server",
  "version": "1.0.0",
  "description": "Backend API server for TaskFlow distributed background job processing platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "dispatcher:dev": "tsx watch src/dispatcher.ts",
    "build": "tsc",
    "worker": "node dist/worker.js",
    "dispatcher": "node dist/dispatcher.js",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "load-test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2"
  }
}
