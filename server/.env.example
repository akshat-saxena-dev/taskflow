PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDIS_URL=redis://localhost:6379
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=1000
SHUTDOWN_GRACE_PERIOD_MS=30000
JOB_SUBMISSION_RATE_LIMIT=60
JOB_SUBMISSION_RATE_WINDOW_MS=60000
QUEUE_MAX_WAITING_JOBS=10000
QUEUE_MAX_PENDING_JOBS=20000
QUEUE_BACKPRESSURE_RETRY_AFTER_SECONDS=5
JOB_STALE_TIMEOUT_MS=600000
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=1
# Set to true only for a non-production crash-recovery demonstration.
TASKFLOW_ENABLE_DEMO_CRASH_HOLD=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
